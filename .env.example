# Local development defaults — never put real secrets in this file.
# Copy to .env and adjust as needed.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://churchos:churchos@localhost:5432/churchos

# OIDC (ADR 0003). Leave unset for local dev — the API then accepts
# unsigned mock tokens (dev-only). Set these in staging/production:
# OIDC_JWKS_URI=https://your-tenant/.well-known/jwks.json
# OIDC_ISSUER=https://your-tenant/
# OIDC_AUDIENCE=churchos-api

# Stripe (ADR 0004). Unset = mock checkout sessions (dev-only).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# GIVING_SUCCESS_URL=http://localhost:3000/giving/success
# GIVING_CANCEL_URL=http://localhost:3000/giving/cancel

# Background check vendor. Unset = mock (dev-only).
# BACKGROUNDCHECK_API_KEY=...

